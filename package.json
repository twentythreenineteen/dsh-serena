{
  "name": "dsh-serena",
  "version": "0.1.0",
  "description": "Mounts the Serena MCP server (LSP-backed semantic code intelligence and editing) as the `serena` tool namespace in DeepSeek Harness.",
  "icon": "icon.svg",
  "type": "module",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twentythreenineteen/dsh-serena.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "mcp",
    "serena",
    "lsp",
    "code-intelligence"
  ],
  "license": "MIT"
}
